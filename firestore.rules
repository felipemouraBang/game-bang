rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isReceptionist() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'receptionist';
    }

    function isStaff() { return isAdmin() || isReceptionist(); }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'receptionist', 'student'];
    }

    function isValidAction(data) {
      return data.keys().hasAll(['user_id', 'type', 'status']) &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() || 
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photo', 'nickname', 'unit', 'email']))
      );
      allow delete: if isAdmin();
    }

    match /actions/{actionId} {
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow get: if isSignedIn() && isValidId(actionId) && (isStaff() || existing().user_id == request.auth.uid);
      
      allow create: if isSignedIn() && isValidAction(incoming()) && incoming().user_id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(actionId) && (
        isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'points', 'validated_by', 'validated_at'])
      );
      allow delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn() && isValidId(challengeId);
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow get: if isSignedIn() && isValidId(notificationId) && existing().user_id == request.auth.uid;
      allow create: if isStaff();
      allow update: if isSignedIn() && isValidId(notificationId) && request.auth.uid == existing().user_id &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid);
    }

    match /logs/{logId} {
      allow read: if isStaff();
      allow write: if isStaff(); 
    }

    match /hall_of_fame/{hallOfFameId} {
      allow read: if isSignedIn() && isValidId(hallOfFameId);
      allow write: if isAdmin();
    }
  }
}
